<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LTFI.ViewModels"
             xmlns:domain="using:LTFI.Core.Domain"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="LTFI.Views.TasksView"
             x:DataType="vm:TasksViewModel"
             mc:Ignorable="d">

    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,*" Margin="28">
        <TextBlock Grid.ColumnSpan="2" Classes="page-title" Text="{Binding Header}"/>

        <!-- Task list -->
        <Border Grid.Row="1" Classes="card" Margin="0,18,12,0">
            <Grid RowDefinitions="Auto,Auto,*">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Button Content="New Task"
                            Classes="primary"
                            HorizontalAlignment="Left"
                            Command="{Binding NewTaskCommand}"
                            ToolTip.Tip="Creates an iCloud reminder (via outbox.json and the LTFI Apply Shortcut)"/>
                    <CheckBox Grid.Column="2"
                              Content="Show archived"
                              VerticalAlignment="Center"
                              IsChecked="{Binding ShowArchived, Mode=TwoWay}"
                              ToolTip.Tip="Also list completed and canceled tasks (in a COMPLETED section at the end)"/>
                </Grid>

                <!-- GROUP: DUE | AREA | NONE    SORT: DUE | PRIORITY | TITLE (wraps when narrow) -->
                <WrapPanel Grid.Row="1" Margin="0,12,0,0" Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,16,4">
                        <TextBlock Classes="micro-dim" Text="GROUP" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <Button Classes="seg" Classes.selected="{Binding IsGroupDue}" Padding="8,3" FontSize="9.5"
                                Content="DUE" Command="{Binding SetGroupingCommand}"
                                CommandParameter="{x:Static domain:TaskGrouping.Due}"
                                ToolTip.Tip="Agenda: overdue, today, tomorrow, this week, later, no due date"/>
                        <Button Classes="seg" Classes.selected="{Binding IsGroupArea}" Padding="8,3" FontSize="9.5"
                                Content="AREA" Command="{Binding SetGroupingCommand}"
                                CommandParameter="{x:Static domain:TaskGrouping.Area}"
                                ToolTip.Tip="One section per area (#list); tasks without an area last"/>
                        <Button Classes="seg" Classes.selected="{Binding IsGroupNone}" Padding="8,3" FontSize="9.5"
                                Content="NONE" Command="{Binding SetGroupingCommand}"
                                CommandParameter="{x:Static domain:TaskGrouping.None}"
                                ToolTip.Tip="One flat list in the chosen sort order"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,4">
                        <TextBlock Classes="micro-dim" Text="SORT" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <Button Classes="seg" Classes.selected="{Binding IsSortDue}" Padding="8,3" FontSize="9.5"
                                Content="DUE" Command="{Binding SetSortCommand}"
                                CommandParameter="{x:Static domain:TaskSort.Due}"
                                ToolTip.Tip="Due date (none last), then priority, then title"/>
                        <Button Classes="seg" Classes.selected="{Binding IsSortPriority}" Padding="8,3" FontSize="9.5"
                                Content="PRIORITY" Command="{Binding SetSortCommand}"
                                CommandParameter="{x:Static domain:TaskSort.Priority}"
                                ToolTip.Tip="Urgent first, then due date, then title"/>
                        <Button Classes="seg" Classes.selected="{Binding IsSortTitle}" Padding="8,3" FontSize="9.5"
                                Content="TITLE" Command="{Binding SetSortCommand}"
                                CommandParameter="{x:Static domain:TaskSort.Title}"
                                ToolTip.Tip="Title A→Z"/>
                    </StackPanel>
                </WrapPanel>

                <!-- Rows = section headers (TaskGroupHeader, not selectable — see code-behind)
                     followed by their tasks. -->
                <ListBox x:Name="TaskList"
                         Grid.Row="2"
                         Margin="0,8,0,0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemsSource="{Binding Rows}"
                         SelectedItem="{Binding SelectedRow, Mode=TwoWay}">
                    <ListBox.Styles>
                        <Style Selector="TextBlock.micro.alert">
                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.DataTemplates>
                        <DataTemplate DataType="vm:TaskGroupHeader">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="{Binding Margin}">
                                <TextBlock Classes="micro" Classes.alert="{Binding IsAlert}" Text="{Binding Label}"/>
                                <TextBlock Classes="micro-dim num" VerticalAlignment="Center" Text="{Binding Count}"/>
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="domain:TaskItem">
                            <!-- checkbox | info (takes the rest, trims) | status chips (auto width) -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="2">
                                <!-- One-click complete. A completed iCloud reminder can't be re-opened
                                     from LTFI, so its box stays checked and disabled. -->
                                <CheckBox VerticalAlignment="Center" MinWidth="0" Padding="0"
                                          IsChecked="{Binding Status, Mode=OneWay, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static domain:TaskStatus.Completed}}"
                                          Command="{ReflectionBinding $parent[UserControl].DataContext.ToggleCompleteCommand}"
                                          CommandParameter="{Binding}"
                                          ToolTip.Tip="Complete this task">
                                    <CheckBox.IsEnabled>
                                        <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                            <Binding Path="!IsExternal"/>
                                            <Binding Path="Status" Converter="{x:Static ObjectConverters.NotEqual}"
                                                     ConverterParameter="{x:Static domain:TaskStatus.Completed}"/>
                                        </MultiBinding>
                                    </CheckBox.IsEnabled>
                                </CheckBox>
                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <WrapPanel Orientation="Horizontal">
                                        <TextBlock Classes="muted" FontSize="12" Margin="0,0,8,0" Text="{Binding Priority}"/>
                                        <TextBlock Classes="muted" FontSize="12" Margin="0,0,8,0"
                                                   IsVisible="{Binding HasTimeSpent}"
                                                   Text="{Binding TimeSpent, Converter={StaticResource DurationToClock}, StringFormat='· {0}'}"/>
                                        <!-- Due date only (no time) -->
                                        <TextBlock Classes="muted" FontSize="12" Margin="0,0,8,0"
                                                   IsVisible="{Binding DueAt, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                   Text="{Binding DueAt, StringFormat='· due {0:yyyy-MM-dd}', FallbackValue=''}"/>
                                        <!-- Area tag (sub-division of the project; also the iPhone list) -->
                                        <TextBlock Classes="muted" FontSize="12"
                                                   IsVisible="{Binding Area, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                   Text="{Binding Area.Name, StringFormat='· #{0}', FallbackValue=''}"/>
                                    </WrapPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button Classes="ghost" Padding="6,1" FontSize="10" Content="+1D"
                                            IsVisible="{Binding IsOpen}"
                                            Command="{ReflectionBinding $parent[UserControl].DataContext.PushDueCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="Push due date 1 day — syncs to iPhone"/>
                                    <Border Classes="chip" IsVisible="{Binding IsPendingOnPhone}"
                                            ToolTip.Tip="Pending on iPhone: the LTFI Apply Shortcut hasn't run, or the next export hasn't arrived yet">
                                        <TextBlock Foreground="{DynamicResource WarningBrush}" Text="PENDING"/>
                                    </Border>
                                    <Border Classes="chip">
                                        <TextBlock Text="{Binding Status}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.DataTemplates>
                </ListBox>
            </Grid>
        </Border>

        <!-- Editor -->
        <Border Grid.Row="1" Grid.Column="1" Classes="card" Margin="0,18,0,0">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="14">
                    <TextBlock Classes="page-title" FontSize="20" Text="{Binding EditorTitle}"/>

                    <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                               IsVisible="{Binding IsCreatingNew}"
                               Text="{Binding CreateTargetText}"/>

                    <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                               IsVisible="{Binding SelectedTask.IsExternal, FallbackValue=False}"
                               Text="An iCloud reminder. Title, description and priority come from your iPhone on every sync — edit those there (until the iPhone has created it, edits here update the pending reminder). A new DUE DATE here is sent to the iPhone via the outbox (it shows PENDING until an export confirms it; clearing a due date must be done on the phone). Completing it here ticks it off on the iPhone. Status and focus time are LTFI's own."/>

                    <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                               IsVisible="{Binding IsPlacementLocked}"
                               Text="Made on the iPhone: its project and area follow its Reminders list (settings.json reminders.listMap, otherwise Life / the list name)."/>

                    <StackPanel Spacing="6">
                        <TextBlock Classes="section-header" Text="TITLE"/>
                        <TextBox Text="{Binding DraftTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Classes="section-header" Text="DESCRIPTION"/>
                        <TextBox Classes="multi" MinHeight="70" Text="{Binding DraftDescription, Mode=TwoWay}"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="section-header" Text="PROJECT"/>
                            <ComboBox HorizontalAlignment="Stretch"
                                      IsEnabled="{Binding CanEditPlacement}"
                                      ItemsSource="{Binding ProjectOptions}"
                                      SelectedItem="{Binding SelectedProjectOption, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ProjectOption">
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Classes="section-header" Text="AREA"/>
                            <ComboBox HorizontalAlignment="Stretch"
                                      IsEnabled="{Binding CanEditPlacement}"
                                      ItemsSource="{Binding AreaOptions}"
                                      SelectedItem="{Binding SelectedAreaOption, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AreaOption">
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="section-header" Text="STATUS"/>
                            <ComboBox HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding Statuses}"
                                      SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Classes="section-header" Text="PRIORITY"/>
                            <ComboBox HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding Priorities}"
                                      SelectedItem="{Binding SelectedPriority, Mode=TwoWay}"/>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="section-header" Text="DUE DATE"/>
                            <TextBox Text="{Binding DraftDueDateText, Mode=TwoWay}"
                                     PlaceholderText="YYYY-MM-DD"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Classes="section-header" Text="REQUIRED FOCUS (MIN)"/>
                            <TextBox Text="{Binding RequiredMinutesText, Mode=TwoWay}"
                                     PlaceholderText="0 = none"/>
                        </StackPanel>
                    </Grid>

                    <!-- Total focused time on this task, summed from completed focus sessions. -->
                    <StackPanel Spacing="6" IsVisible="{Binding !IsCreatingNew}">
                        <TextBlock Classes="section-header" Text="TIME SPENT"/>
                        <TextBlock FontSize="18"
                                   Text="{Binding SelectedTask.TimeSpent, Converter={StaticResource DurationToClock}}"/>
                    </StackPanel>

                    <TextBlock Foreground="{DynamicResource WarningBrush}"
                               TextWrapping="Wrap"
                               Text="{Binding FeedbackMessage}"/>

                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                        <Button Classes="primary"
                                Content="{Binding SaveButtonText}"
                                Command="{Binding SaveTaskCommand}"/>
                        <Button Grid.Column="1"
                                Classes="danger"
                                Content="Delete"
                                Command="{Binding DeleteTaskCommand}"/>
                    </Grid>

                    <!-- Subtasks (available once the task is saved) -->
                    <Border BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="0,14,0,0"
                            IsVisible="{Binding CanManageSubtasks}">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="section-header" Text="SUBTASKS"/>

                            <ItemsControl ItemsSource="{Binding Subtasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SubtaskItemViewModel">
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                            <CheckBox Content="{Binding Title}"
                                                      IsChecked="{Binding IsCompleted, Mode=TwoWay}"/>
                                            <Button Grid.Column="1"
                                                    Classes="danger"
                                                    Content="Remove"
                                                    Padding="10,4"
                                                    Command="{ReflectionBinding $parent[UserControl].DataContext.DeleteSubtaskCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <TextBox Text="{Binding NewSubtaskTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="Add a subtask…"/>
                                <Button Grid.Column="1"
                                        Content="Add"
                                        Command="{Binding AddSubtaskCommand}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
