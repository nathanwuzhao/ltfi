<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LTFI.ViewModels"
             xmlns:c="using:LTFI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="LTFI.Views.FocusView"
             x:DataType="vm:FocusViewModel"
             mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*" Margin="28">
        <TextBlock Classes="page-title" Text="{Binding Header}"/>

        <!-- Stretch + MaxWidth = a fixed 560 column (centred by layout), never sized by its
             content: with HorizontalAlignment=Center the card was auto-width, so typing in
             the intent/review boxes made it grow sideways. -->
        <Border Grid.Row="1" Classes="card" Margin="0,18,0,0"
                MaxWidth="560" HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <StackPanel Spacing="16">

                <!-- Setup: choose what to work on -->
                <StackPanel Spacing="14" IsVisible="{Binding ShowSetup}">
                    <TextBlock Classes="section-header" Text="START A FOCUS SESSION"/>

                    <StackPanel Spacing="6">
                        <TextBlock Classes="micro-dim" Text="TIMER"/>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Classes="seg" Classes.selected="{Binding IsPomodoroMode}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Content="POMODORO · 25 / 5" Command="{Binding UsePomodoroCommand}"/>
                            <Button Grid.Column="1" Classes="seg" Classes.selected="{Binding IsFreeMode}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Content="FREE · COUNT UP" Command="{Binding UseFreeCommand}"/>
                        </Grid>
                        <!-- WrapTextBlock: a plain TextBlock lost this hint's 2nd line at 125% scaling
                             (layout rounding vs. TextLayout's MaxHeight; see Controls/WrapTextBlock.cs) -->
                        <c:WrapTextBlock Classes="faint" FontSize="10" TextWrapping="Wrap" IsVisible="{Binding IsPomodoroMode}"
                                         Text="25:00 work, 5:00 break, 15:00 long break after every 4th. Only work time counts toward the session."/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Classes="muted" Text="Project"/>
                        <ComboBox HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding ProjectOptions}"
                                  SelectedItem="{Binding SelectedProjectOption, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProjectOption">
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Classes="muted" Text="Task"/>
                        <ComboBox HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding TaskOptions}"
                                  SelectedItem="{Binding SelectedTaskOption, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:TaskOption">
                                    <TextBlock Text="{Binding Title}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Classes="muted" Text="Intent"/>
                        <TextBox Classes="multi" MinHeight="44"
                                 Text="{Binding IntentText, Mode=TwoWay}"
                                 PlaceholderText="What will you get done this session?"/>
                    </StackPanel>

                    <Button Classes="primary" Content="Start session" Command="{Binding StartCommand}"/>

                    <!-- Standalone NSDR: no session needed -->
                    <Border BorderBrush="{DynamicResource BorderInnerBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <TextBlock Classes="micro" Text="NON-SLEEP DEEP REST" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Classes="ghost" Content="NSDR 10:00" Command="{Binding StartNsdrCommand}"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- NSDR: calm countdown + timed guide -->
                <StackPanel Spacing="14" IsVisible="{Binding ShowNsdr}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="micro" Text="NSDR · NON-SLEEP DEEP REST" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Classes="micro-dim" Text="{Binding NsdrStepText}" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Classes="num" Text="{Binding NsdrCountdownText}"
                               FontSize="56" FontWeight="SemiBold" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ProgressBar Classes="meter" Value="{Binding NsdrProgress}" Foreground="{DynamicResource TextDimBrush}"/>
                    <Border Background="{DynamicResource BgInsetBrush}" CornerRadius="4" Padding="16,14">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="bright" FontSize="15" Text="{Binding NsdrCueTitle}"/>
                            <TextBlock Classes="muted" FontSize="13" LineHeight="20" TextWrapping="Wrap" Text="{Binding NsdrCueText}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Classes="faint" FontSize="10" Text="{Binding NsdrNextText}"/>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <StackPanel Orientation="Horizontal">
                            <!-- local file: played in-app; http(s) link: opened in the browser -->
                            <Button Classes="ghost" Content="{Binding NsdrAudioToggleText}" IsVisible="{Binding IsNsdrAudioLocal}"
                                    Command="{Binding ToggleNsdrAudioCommand}"/>
                            <Button Classes="ghost" Content="OPEN AUDIO" IsVisible="{Binding ShowOpenAudio}"
                                    Command="{Binding OpenNsdrAudioCommand}"/>
                        </StackPanel>
                        <Button Grid.Column="2" Classes="ghost" Content="{Binding NsdrStopText}"
                                Command="{Binding StopNsdrCommand}"/>
                    </Grid>
                </StackPanel>

                <!-- Active: the running timer -->
                <StackPanel Spacing="16" IsVisible="{Binding ShowActive}">
                    <TextBlock Classes="section-header" Text="CURRENT OPERATION"/>
                    <c:WrapTextBlock Text="{Binding CurrentObjective}" FontSize="16" TextWrapping="Wrap"/>

                    <!-- Free mode: count up -->
                    <TextBlock Text="{Binding ElapsedText}" IsVisible="{Binding ShowFreeTimer}"
                               FontSize="56" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource AccentBrush}"/>

                    <!-- Pomodoro mode: phase countdown -->
                    <StackPanel Spacing="10" IsVisible="{Binding IsPomodoroActive}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{Binding PhaseBrush}"/>
                                <TextBlock Classes="micro" Text="{Binding PhaseLabel}" Foreground="{Binding PhaseBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Classes="micro-dim" Text="{Binding PomodorosText}" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Classes="num" Text="{Binding CountdownText}"
                                   FontSize="56" FontWeight="SemiBold" HorizontalAlignment="Center"
                                   Foreground="{Binding PhaseBrush}"/>
                        <TextBlock Text="{Binding PomodoroDots}" FontSize="18" LetterSpacing="4"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource TextDimBrush}"/>
                        <TextBlock Classes="dim" FontSize="10" HorizontalAlignment="Center">
                            <TextBlock.Text><Binding Path="ElapsedText" StringFormat="WORK TIME THIS SESSION {0}"/></TextBlock.Text>
                        </TextBlock>

                        <!-- break running: skip, or swap a long break for NSDR -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding IsBreakRunning}">
                            <Button Classes="ghost" Content="SKIP BREAK"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Command="{Binding SkipBreakCommand}"/>
                            <Button Grid.Column="1" Classes="ghost" Content="TAKE NSDR INSTEAD" IsVisible="{Binding CanTakeNsdr}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Command="{Binding TakeNsdrInsteadCommand}"/>
                        </Grid>

                        <!-- break over: wait for the user -->
                        <StackPanel Spacing="8" IsVisible="{Binding IsBreakOver}">
                            <TextBlock Classes="micro" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center"
                                       Text="BREAK OVER — START NEXT POMODORO"/>
                            <Button Classes="primary" Content="START NEXT POMODORO"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Command="{Binding StartNextPomodoroCommand}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- NSDR inside the session: pauses the clock (NSDR time is not work time) -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" IsVisible="{Binding CanStartSessionNsdr}">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="micro" Text="NON-SLEEP DEEP REST"/>
                            <c:WrapTextBlock Classes="faint" FontSize="10" TextWrapping="Wrap"
                                             Text="Pauses the session clock; logged (+3) when the full 10:00 is done."/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="ghost" Content="NSDR 10:00" VerticalAlignment="Center"
                                ToolTip.Tip="Rest now. The work interval resumes where it was; a break is replaced by the NSDR."
                                Command="{Binding StartSessionNsdrCommand}"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <Button Content="{Binding PauseResumeText}"
                                IsEnabled="{Binding IsWorkPhase}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Command="{Binding PauseResumeCommand}"/>
                        <Button Grid.Column="1" Classes="primary"
                                Content="Finish"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Command="{Binding BeginFinishCommand}"/>
                        <Button Grid.Column="2" Classes="danger"
                                Content="Abandon"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Command="{Binding AbandonCommand}"/>
                    </Grid>
                </StackPanel>

                <!-- Review: end-of-session capture -->
                <StackPanel Spacing="14" IsVisible="{Binding ShowReview}">
                    <TextBlock Classes="section-header" Text="SESSION REVIEW"/>

                    <StackPanel Spacing="6">
                        <TextBlock Classes="muted" Text="What happened?"/>
                        <ComboBox HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding Results}"
                                  SelectedItem="{Binding SelectedResult, Mode=TwoWay}"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Classes="muted" Text="What changed?"/>
                        <TextBox Classes="multi" Text="{Binding ReviewSummary, Mode=TwoWay}"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Classes="muted" Text="Blocker (if any)"/>
                        <TextBox Classes="multi" MinHeight="44" Text="{Binding ReviewBlocker, Mode=TwoWay}"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Classes="muted" Text="Next concrete action"/>
                        <TextBox Classes="multi" MinHeight="44" Text="{Binding ReviewNext, Mode=TwoWay}"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                        <Button Classes="primary" Content="Save session" Command="{Binding ConfirmFinishCommand}"/>
                        <Button Grid.Column="1" Content="Back" Command="{Binding CancelFinishCommand}"/>
                    </Grid>
                </StackPanel>

                <TextBlock Foreground="{DynamicResource WarningBrush}"
                           TextWrapping="Wrap"
                           Text="{Binding FeedbackMessage}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
