<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LTFI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1400"
        d:DesignHeight="860"
        Width="1400"
        Height="860"
        MinWidth="1120"
        MinHeight="640"
        x:Class="LTFI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Background="{DynamicResource BgWindowBrush}"
        Title="LTFI // Command Center">

    <Grid RowDefinitions="36,*">

        <!-- ============ TOP STATUS BAR ============ -->
        <Border Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="13,0">

                <!-- wordmark -->
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="LTFI" FontSize="12" FontWeight="ExtraBold"
                               LetterSpacing="3" Foreground="{DynamicResource TextBrightBrush}"/>
                    <TextBlock Text="//" FontSize="11" Foreground="{DynamicResource TextFainterBrush}"/>
                    <TextBlock Text="COMMAND CENTER" FontSize="9.5" LetterSpacing="1.6"
                               Foreground="{DynamicResource TextDimBrush}"/>
                </StackPanel>

                <!-- live status readout -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DateText}" FontSize="10" LetterSpacing="0.6"
                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="·" Foreground="{DynamicResource TextFainterBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ClockText}" Classes="num" FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="·" Foreground="{DynamicResource TextFainterBrush}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Background="Transparent"
                                ToolTip.Tip="Points earned today (local day): task 10, check-in 10, focus session 5, commitment kept 5, NSDR 3, subtask 2">
                        <TextBlock Text="PTS TODAY" FontSize="10" Foreground="{DynamicResource TextDimBrush}"/>
                        <TextBlock Text="{Binding PointsToday}" Classes="num" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBodyBrush}"/>
                    </StackPanel>
                    <TextBlock Text="·" Foreground="{DynamicResource TextFainterBrush}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Background="Transparent"
                                ToolTip.Tip="Activity streak: consecutive days with any recorded activity (the contribution graph's current streak). Today not done yet doesn't break it. The focus-only streak is in the Focus Debt panel.">
                        <TextBlock Text="STREAK" FontSize="10" Foreground="{DynamicResource TextDimBrush}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding StreakDays}" Classes="num" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="d" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="·" Foreground="{DynamicResource TextFainterBrush}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Background="Transparent"
                                ToolTip.Tip="Active projects / limit. Standing projects (like Life) don't count toward the limit.">
                        <TextBlock Text="ACTIVE" FontSize="10" Foreground="{DynamicResource TextDimBrush}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ActiveMeterFilled}" FontSize="10" LetterSpacing="2"
                                       Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="{Binding ActiveMeterEmpty}" FontSize="10" LetterSpacing="2"
                                       Foreground="{DynamicResource TextFainterBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ActiveText}" Classes="num" FontSize="10"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ RAIL + CONTENT ============ -->
        <Grid Grid.Row="1" ColumnDefinitions="46,*">

            <!-- 46px icon rail -->
            <Border Background="{DynamicResource BgPanelBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="*,Auto">
                    <ListBox Classes="rail"
                             IsEnabled="{Binding IsNavEnabled}"
                             ItemsSource="{Binding NavItems}"
                             SelectedItem="{Binding SelectedNav, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:NavItem">
                                <Border Classes="rail-item">
                                    <TextBlock Text="{Binding Code}"/>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- bottom-pinned Settings (not part of the selectable list) -->
                    <Button Grid.Row="1"
                            Command="{Binding OpenSettingsCommand}"
                            IsEnabled="{Binding IsNavEnabled}"
                            Background="Transparent" BorderThickness="0" Padding="0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Border Classes="rail-item"
                                BorderThickness="2,0,0,0"
                                Background="{Binding IsSettingsActive, Converter={x:Static vm:ShellConverters.RailActiveBg}}"
                                BorderBrush="{Binding IsSettingsActive, Converter={x:Static vm:ShellConverters.RailActiveBorder}}">
                            <TextBlock Text="SET"
                                       Foreground="{Binding IsSettingsActive, Converter={x:Static vm:ShellConverters.RailActiveText}}"/>
                        </Border>
                    </Button>
                </Grid>
            </Border>

            <!-- content region -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"/>
        </Grid>
    </Grid>
</Window>
