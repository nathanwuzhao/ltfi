<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LTFI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="900"
             x:Class="LTFI.Views.CheckInView"
             x:DataType="vm:CheckInViewModel"
             Background="{DynamicResource BgWindowBrush}">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="9" Spacing="8">

            <!-- header strip: title + due status -->
            <Border Classes="panel">
                <Grid Margin="12,10" ColumnDefinitions="Auto,*">
                    <TextBlock Classes="page-title" Text="{Binding Header}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Margin="16,0,0,0" FontSize="11" TextWrapping="Wrap"
                               VerticalAlignment="Center" Text="{Binding StatusText}"
                               Foreground="{DynamicResource WarningBrush}" IsVisible="{Binding IsDue}"/>
                    <TextBlock Grid.Column="1" Margin="16,0,0,0" FontSize="11" TextWrapping="Wrap"
                               VerticalAlignment="Center" Text="{Binding StatusText}"
                               Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding !IsDue}"/>
                </Grid>
            </Border>

            <Grid ColumnDefinitions="2*,*" ColumnSpacing="8">

                <!-- ==== LEFT: last week's commitments + the questions ==== -->
                <StackPanel Spacing="8" VerticalAlignment="Top">

                <!-- LAST WEEK'S COMMITMENTS: settle each (kept / missed / carry over) -->
                <Border Classes="panel" IsVisible="{Binding HasPastCommitments}">
                    <StackPanel>
                        <Border Classes="panel-hd">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="micro" Text="LAST WEEK'S COMMITMENTS"/>
                                <TextBlock Grid.Column="1" Classes="micro-dim" Text="{Binding PastSummary}"/>
                            </Grid>
                        </Border>
                        <ItemsControl ItemsSource="{Binding PastCommitments}" Margin="0,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PastCommitment">
                                    <Border Padding="12,7" BorderBrush="{DynamicResource BorderRowBrush}" BorderThickness="0,0,0,1">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Classes="bright" FontSize="11.5" TextWrapping="Wrap" Text="{Binding Text}"/>
                                                <TextBlock Classes="dim" FontSize="9.5" TextTrimming="CharacterEllipsis" Text="{Binding Meta}"
                                                           IsVisible="{Binding Meta, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" FontSize="10" FontWeight="SemiBold" LetterSpacing="0.6" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource SuccessBrush}" Text="{Binding KeptLabel}"
                                                       IsVisible="{Binding IsAlreadyKept}"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"
                                                        IsVisible="{Binding NeedsChoice}">
                                                <Button Classes="seg" Classes.selected="{Binding IsKeptChoice}" Padding="8,4" FontSize="9.5"
                                                        Content="KEPT" Command="{Binding ChooseKeptCommand}"/>
                                                <Button Classes="seg" Classes.selected="{Binding IsMissedChoice}" Padding="8,4" FontSize="9.5"
                                                        Content="MISSED" Command="{Binding ChooseMissedCommand}"/>
                                                <Button Classes="seg" Classes.selected="{Binding IsCarryChoice}" Padding="8,4" FontSize="9.5"
                                                        Content="CARRY OVER" Command="{Binding ChooseCarryCommand}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Classes="faint" FontSize="9.5" Margin="12,2,12,10" TextWrapping="Wrap"
                                   Text="Anything left unchosen counts as missed when you submit. Carry over copies it into this week's commitments below."/>
                    </StackPanel>
                </Border>

                <Border Classes="panel">
                    <StackPanel>
                        <Border Classes="panel-hd">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="micro" Text="QUESTIONS"/>
                                <TextBlock Grid.Column="1" Classes="micro-dim" Text="WEEKLY-CHECKIN-V1"/>
                            </Grid>
                        </Border>

                        <ItemsControl ItemsSource="{Binding Questions}" Margin="12,8,12,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CheckInQuestion">
                                    <StackPanel Spacing="5" Margin="0,0,0,12">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Classes="num faint" FontSize="10.5" FontWeight="Bold"
                                                       Margin="0,0,10,0" Text="{Binding Number}"/>
                                            <TextBlock Grid.Column="1" Classes="bright" FontSize="11.5"
                                                       TextWrapping="Wrap" Text="{Binding Prompt}"/>
                                        </Grid>
                                        <TextBox Text="{Binding Answer, Mode=TwoWay}"
                                                 AcceptsReturn="True" TextWrapping="Wrap"
                                                 MinHeight="54" FontSize="11.5"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Q5: three structured commitment rows, each optionally linked to a reminder -->
                        <StackPanel Spacing="5" Margin="12,0,12,12">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Classes="num faint" FontSize="10.5" FontWeight="Bold"
                                           Margin="0,0,10,0" Text="{Binding CommitmentsNumber}"/>
                                <TextBlock Grid.Column="1" Classes="bright" FontSize="11.5"
                                           TextWrapping="Wrap" Text="{Binding CommitmentsPrompt}"/>
                                <TextBlock Grid.Column="2" Classes="micro-dim" Margin="8,0,0,0"
                                           Foreground="{DynamicResource WarningBrush}" Text="AT LEAST 1"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding CommitmentInputs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CommitmentInput">
                                        <Grid ColumnDefinitions="18,*,8,240" Margin="0,0,0,5">
                                            <TextBlock Classes="num dim" FontSize="10.5" VerticalAlignment="Center" Text="{Binding Number}"/>
                                            <TextBox Grid.Column="1" FontSize="11.5" Text="{Binding Text, Mode=TwoWay}"
                                                     PlaceholderText="commitment — with a first step under 10 minutes"/>
                                            <ComboBox Grid.Column="3" FontSize="10.5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                      ItemsSource="{Binding LinkOptions}" SelectedItem="{Binding SelectedLink, Mode=TwoWay}"
                                                      ToolTip.Tip="Link to an open reminder: completing it keeps this commitment automatically">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:LinkOption">
                                                        <TextBlock FontSize="10.5" TextTrimming="CharacterEllipsis" Text="{Binding Label}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding QuestionsAfter}" Margin="12,0,12,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CheckInQuestion">
                                    <StackPanel Spacing="5" Margin="0,0,0,12">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Classes="num faint" FontSize="10.5" FontWeight="Bold"
                                                       Margin="0,0,10,0" Text="{Binding Number}"/>
                                            <TextBlock Grid.Column="1" Classes="bright" FontSize="11.5"
                                                       TextWrapping="Wrap" Text="{Binding Prompt}"/>
                                        </Grid>
                                        <TextBox Text="{Binding Answer, Mode=TwoWay}"
                                                 AcceptsReturn="True" TextWrapping="Wrap"
                                                 MinHeight="54" FontSize="11.5"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border BorderBrush="{DynamicResource BorderInnerBrush}" BorderThickness="0,1,0,0" Padding="12,9">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="primary" Content="SUBMIT CHECK-IN" Command="{Binding SubmitCommand}"/>
                                    <Button Classes="ghost" Content="{Binding SnoozeLabel}" Command="{Binding SnoozeCommand}"
                                            IsVisible="{Binding IsDue}"/>
                                </StackPanel>
                                <TextBlock Foreground="{DynamicResource WarningBrush}" FontSize="11"
                                           TextWrapping="Wrap" Text="{Binding FeedbackMessage}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
                </StackPanel>

                <!-- ==== RIGHT: context + history ==== -->
                <StackPanel Grid.Column="1" Spacing="8">

                    <!-- this week's numbers (deterministic review) -->
                    <Border Classes="panel">
                        <StackPanel>
                            <Border Classes="panel-hd">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="micro" Text="THIS WEEK"/>
                                    <TextBlock Grid.Column="1" Classes="micro-dim" Text="TRAILING 7D"/>
                                </Grid>
                            </Border>
                            <Grid ColumnDefinitions="*,*,*,*" Margin="12,10">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="micro-dim" Text="FOCUS"/>
                                    <TextBlock Classes="num bright" FontSize="17" FontWeight="Bold" Text="{Binding FocusText}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Classes="micro-dim" Text="TASKS DONE"/>
                                    <TextBlock Classes="num bright" FontSize="17" FontWeight="Bold" Text="{Binding TasksCompleted}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="3">
                                    <TextBlock Classes="micro-dim" Text="STALLED"/>
                                    <TextBlock Classes="num bright" FontSize="17" FontWeight="Bold" Text="{Binding StalledCount}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Spacing="3">
                                    <TextBlock Classes="micro-dim" Text="ACTIVE"/>
                                    <TextBlock Classes="num bright" FontSize="17" FontWeight="Bold" Text="{Binding ActiveText}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- past check-ins -->
                    <Border Classes="panel">
                        <StackPanel>
                            <Border Classes="panel-hd">
                                <TextBlock Classes="micro" Text="PAST CHECK-INS"/>
                            </Border>
                            <ItemsControl ItemsSource="{Binding History}" IsVisible="{Binding HasHistory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CheckInHistoryItem">
                                        <Border Padding="12,8" BorderBrush="{DynamicResource BorderRowBrush}" BorderThickness="0,0,0,1">
                                            <StackPanel Spacing="4">
                                                <TextBlock Classes="micro-dim" Text="{Binding DateText}"/>
                                                <TextBlock Classes="bright" FontSize="11" TextWrapping="Wrap" Text="{Binding Commitments}"/>
                                                <TextBlock Classes="dim" FontSize="10.5" TextWrapping="Wrap" Text="{Binding Summary}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Classes="faint" FontSize="10.5" Margin="12,10" IsVisible="{Binding !HasHistory}"
                                       Text="No check-ins yet. Your commitments will show here."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
